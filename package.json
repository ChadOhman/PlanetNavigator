{
  "name": "planetnavigator-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app",
    "tools/tile-slicer"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "dist": "npm run dist -w app",
    "tiles": "npm run slice -w tools/tile-slicer",
    "icon": "node tools/make-icon.mjs",
    "predist": "node tools/make-icon.mjs",
    "release": "node tools/release.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
